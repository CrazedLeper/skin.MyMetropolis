<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- Independent of library Container.Content and the library Hide Plot option. -->
	<include name="MyMetropolisQueuePlot">
		<control type="group" id="9900">
			<visible>Window.IsActive(videoplaylist)</visible>
			<posx>300</posx>
			<posy>560</posy>
			<control type="textbox">
				<include>Animation_FadedByMenuExceptions</include>
				<include>Animation_OpenCloseFade</include>
				<include>Animation_HiddenByInfo</include>
				<width>750</width>
				<height>84</height>
				<font>METF_PlotTextSmall</font>
				<textcolor>LowerText</textcolor>
				<label>$INFO[Window(Home).Property(MyMetropolis.QueuePlot)]</label>
				<align>justify</align>
				<autoscroll time="2000" delay="8000" repeat="4000">true</autoscroll>
				<visible>Control.IsVisible(9905) | Control.IsVisible(9906)</visible>
			</control>
			<control type="textbox">
				<include>Animation_FadedByMenuExceptions</include>
				<include>Animation_OpenCloseFade</include>
				<include>Animation_HiddenByInfo</include>
				<width>750</width>
				<height>132</height>
				<font>METF_PlotTextSmall</font>
				<textcolor>LowerText</textcolor>
				<label>$INFO[Window(Home).Property(MyMetropolis.QueuePlot)]</label>
				<align>justify</align>
				<autoscroll time="2000" delay="12000" repeat="4000">true</autoscroll>
				<visible>![Control.IsVisible(9905) | Control.IsVisible(9906)]</visible>
			</control>
		</control>
	</include>
	<!-- These IDs are outside Kodi's native sort controls (3 and 4). -->
	<include name="MyMetropolisPlaylistSortButtons">
		<control type="button" id="7301">
			<description>Sort the video playback queue</description>
			<visible>Window.IsActive(videoplaylist)</visible>
			<width>340</width>
			<height>40</height>
			<align>left</align>
			<aligny>center</aligny>
			<font>METF_DialogLarge</font>
			<label>$LOCALIZE[550]: $INFO[Window(Home).Property(MyMetropolis.SortMethodLabel)]</label>
			<textoffsetx>20</textoffsetx>
			<textcolor>TextNF</textcolor>
			<focusedcolor>DialogTextFO</focusedcolor>
			<disabledcolor>TextDisabled</disabledcolor>
			<texturefocus>ButtonFO2Wide.png</texturefocus>
			<texturenofocus></texturenofocus>
			<pulseonselect>false</pulseonselect>
			<onclick>RunScript(special://skin/extras/playlist_sort.py,choose)</onclick>
		</control>
		<control type="button" id="7302">
			<description>Change queue sort direction</description>
			<visible>Window.IsActive(videoplaylist)</visible>
			<width>340</width>
			<height>40</height>
			<align>left</align>
			<aligny>center</aligny>
			<font>METF_DialogLarge</font>
			<label>$INFO[Window(Home).Property(MyMetropolis.SortOrderLabel)]</label>
			<textoffsetx>20</textoffsetx>
			<textcolor>TextNF</textcolor>
			<focusedcolor>DialogTextFO</focusedcolor>
			<disabledcolor>TextDisabled</disabledcolor>
			<texturefocus>ButtonFO2Wide.png</texturefocus>
			<texturenofocus></texturenofocus>
			<pulseonselect>false</pulseonselect>
			<onclick>RunScript(special://skin/extras/playlist_sort.py,direction)</onclick>
		</control>
	</include>
</includes>
